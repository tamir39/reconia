# Shell scripts and the Docker entrypoint must keep LF endings: they run inside
# Linux containers, where a CRLF shebang line fails with "no such file or directory".
*.sh text eol=lf
entrypoint.sh text eol=lf
Dockerfile text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Evaluation evidence contains hashes of exact file bytes. Do not rewrite line
# endings when these artifacts are checked out on another operating system.
reports/predictions/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
reports/runs/**/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
