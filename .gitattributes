* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.model binary
# Preserve whitespace in historical snapshots and original training logs.
archive/** whitespace=-blank-at-eol,-blank-at-eof
reports/archive/** whitespace=-blank-at-eol,-blank-at-eof
reports/benchmarks/**/train.log whitespace=-blank-at-eol,-blank-at-eof
