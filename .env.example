# Copy to .env and fill in. NEVER commit .env
POSTGRES_USER=reconia
POSTGRES_PASSWORD=reconia
POSTGRES_DB=reconia
POSTGRES_HOST=localhost
# 5432-5436 are used by other projects on this machine; Reconia uses 5437.
POSTGRES_PORT=5437

APP_HOST=0.0.0.0
# 8000, 8080 and 8501 are used by other projects on this machine; Reconia uses 8010.
APP_PORT=8010
APP_DEBUG=true

# Optional. System must run fully without it.
GEMINI_API_KEY=
